# Copy to .env and edit. Empty values mean "unset". Secrets stay commented out here.

# --- API server ---
# EARMARK_API_TOKEN=
EARMARK_HOST=127.0.0.1
EARMARK_PORT=8787

# --- Storage ---
EARMARK_DATA_DIR=./data
# EARMARK_VAULT_DIR=
EARMARK_VAULT_SUBDIR=Earmark
# EARMARK_OBSIDIAN_VAULT_NAME=

# --- Backends (fake exists for tests; none disables index and notify) ---
EARMARK_RESOLVER_BACKEND=apple
EARMARK_FETCH_BACKEND=http
EARMARK_ASR_BACKEND=faster_whisper
EARMARK_LLM_PROVIDER=anthropic
EARMARK_STORE_BACKEND=vault
EARMARK_INDEX_BACKEND=lancedb
EARMARK_NOTIFY_BACKEND=ntfy

# --- Transcription ---
EARMARK_ASR_MODEL=large-v3
EARMARK_ASR_DEVICE=auto
EARMARK_ASR_COMPUTE_TYPE=auto
# EARMARK_ASR_MODEL_DIR=
# EARMARK_ASR_LANGUAGE=
# EARMARK_ASR_BASE_URL=
# EARMARK_ASR_API_KEY=
# EARMARK_ASR_MAX_UPLOAD_MB=
# EARMARK_ASR_TIMEOUT_SECONDS=10800
# EARMARK_ASR_MODEL and EARMARK_ASR_LANGUAGE also apply to the remote backend.
EARMARK_KEEP_AUDIO=false

# --- Analysis ---
EARMARK_LLM_MODEL=claude-opus-5-5
EARMARK_LLM_EFFORT=medium
EARMARK_LLM_FALLBACKS=true
# EARMARK_LLM_BASE_URL=
# EARMARK_LLM_API_KEY=
# EARMARK_LLM_CONTEXT_TOKENS=
# EARMARK_LLM_TIMEOUT_SECONDS=3600
EARMARK_LLM_RESPONSE_FORMAT=json_schema
# Anthropic: EARMARK_LLM_API_KEY is the API key (ANTHROPIC_API_KEY in the process
# environment also works; in .env it is not read). EARMARK_LLM_CONTEXT_TOKENS defaults
# to 1000000 for Anthropic. openai_compat (a local server, see docs/llm.md) needs
# EARMARK_LLM_BASE_URL, EARMARK_LLM_MODEL (the server's model id), and
# EARMARK_LLM_CONTEXT_TOKENS (the server's context window); EFFORT and FALLBACKS are
# Claude-only.

# --- Index ---
EARMARK_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Notifications ---
# EARMARK_NTFY_URL=
# EARMARK_NTFY_TOKEN=

# --- Limits and fetching ---
EARMARK_MAX_AUDIO_MB=1024
EARMARK_MAX_FEED_MB=20
EARMARK_ALLOW_PRIVATE_FETCH=false

# --- Worker ---
EARMARK_JOB_MAX_ATTEMPTS=4
EARMARK_JOB_LEASE_SECONDS=900
EARMARK_WORKER_POLL_SECONDS=2.0

# --- Misc ---
# EARMARK_TZ=
EARMARK_LOG_LEVEL=INFO
