# Copy to .env and edit. Empty values mean "unset". Secrets stay commented out here.

# --- API server ---
# EARMARK_API_TOKEN=
EARMARK_HOST=127.0.0.1
EARMARK_PORT=8787

# --- Storage ---
EARMARK_DATA_DIR=./data

# --- Backends (fake exists for tests; none disables notify) ---
EARMARK_RESOLVER_BACKEND=apple
EARMARK_FETCH_BACKEND=http
EARMARK_ASR_BACKEND=faster_whisper
EARMARK_MAIL_BACKEND=smtp
EARMARK_NOTIFY_BACKEND=ntfy

# --- Transcription ---
EARMARK_ASR_MODEL=large-v3
EARMARK_ASR_DEVICE=auto
# Compose's worker forces cuda and uses float16 unless this line is set.
# EARMARK_ASR_COMPUTE_TYPE=auto
# faster-whisper's batched pipeline: chunks decoded together (try 8 or 16 on a GPU); 0 is off.
EARMARK_ASR_BATCH_SIZE=0
# EARMARK_ASR_MODEL_DIR=
# EARMARK_ASR_LANGUAGE=
# EARMARK_ASR_BASE_URL=
# EARMARK_ASR_API_KEY=
# EARMARK_ASR_MAX_UPLOAD_MB=
# EARMARK_ASR_TIMEOUT_SECONDS=10800
# EARMARK_ASR_MODEL and EARMARK_ASR_LANGUAGE also apply to the remote backend.
EARMARK_KEEP_AUDIO=false

# --- Mail (the transcript is emailed to the request's destination) ---
# The smtp backend needs a host, a sender address, and a login. It always verifies TLS and
# always logs in; there is no plaintext mode. Use a mailbox whose domain has SPF, DKIM and DMARC.
# EARMARK_SMTP_HOST=smtp.example.org
# Unset: 587 for starttls, 465 for tls (implicit TLS).
# EARMARK_SMTP_PORT=
EARMARK_SMTP_SECURITY=starttls
# EARMARK_SMTP_USERNAME=
# EARMARK_SMTP_PASSWORD=
# The From address. Its domain is also the EHLO name and the Message-ID domain.
# EARMARK_SMTP_FROM=earmark@example.org
# The whole SMTP session must finish within this many seconds (at most 90).
EARMARK_SMTP_TIMEOUT_S=60.0
# The transcript and the instructions together may not exceed this (MiB); nothing is truncated.
EARMARK_MAX_ATTACHMENT_MB=10

# --- Notifications ---
# The ntfy topic URL, ending in the topic name (letters, digits, - and _; at most 64).
# It is a secret: on public ntfy.sh the topic name is the only protection, so pick a long
# random one (at least 12 characters; earmark masks it in logs and notifications).
# No credentials in the URL; use EARMARK_NTFY_TOKEN for an access token.
# EARMARK_NTFY_URL=https://ntfy.sh/your-long-random-topic
# EARMARK_NTFY_TOKEN=

# --- Requests ---
# Who may receive transcripts: comma-separated addresses, or all. Unset refuses every request.
# EARMARK_ALLOWED_RECIPIENTS=you@example.org
# Largest audio upload accepted (MiB).
EARMARK_MAX_UPLOAD_MB=1024
# A repeat of the same request within this many seconds of a finished job returns that job.
EARMARK_DEDUPE_WINDOW_S=600

# --- Limits and fetching ---
EARMARK_MAX_AUDIO_MB=1024
EARMARK_MAX_FEED_MB=20
EARMARK_ALLOW_PRIVATE_FETCH=false

# --- Worker ---
EARMARK_JOB_MAX_ATTEMPTS=4
EARMARK_JOB_LEASE_SECONDS=900
EARMARK_WORKER_POLL_SECONDS=2.0

# --- Misc ---
EARMARK_LOG_LEVEL=INFO

# --- Docker Compose only (unprefixed; earmark itself ignores them) ---
# See docs/deploy.md.
# API_BIND=127.0.0.1:8787
# APP_UID=1000
# APP_GID=1000
# EXTRAS=transcribe
# Hugging Face telemetry in the api and worker containers: off (1); 0 turns it on.
# A native install ignores this line; the units set it (docs/deploy.md section 17).
# HF_HUB_DISABLE_TELEMETRY=1
